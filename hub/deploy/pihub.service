[Unit]
Description=PiHub - homelab coordinator (inventory, sync rounds, file fetch, agent monitor)
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
User=som
Group=som
WorkingDirectory=/home/som/pihub
EnvironmentFile=/etc/pihub.env
ExecStart=/usr/bin/python3 /home/som/pihub/app.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
